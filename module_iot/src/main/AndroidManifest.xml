        <activity
            android:name=".ui.device.detail.DeviceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.device.settings.DeviceSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.provision.ProvisionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.debug.MqttDebugActivity"
            android:exported="false" />

        <service
            android:name="info.mqtt.android.service.MqttService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
